    },
    {
      "title": "Migrate Helm values renamed or removed in 3.0",
      "detail": "Several control-plane Helm values are renamed or dropped. Diff your release against the 3.0 chart before upgrading.",
      "command": "helm get values kong-mesh -n kong-mesh-system -o yaml > values.bak.yaml\nhelm diff upgrade kong-mesh kong-mesh/kong-mesh \\\n  -f values.bak.yaml --version 3.0.0"
    },
    {
      "title": "Snapshot the control-plane datastore before upgrading",
      "detail": "Back up Postgres (Universal) or the Kubernetes resources so the migration is reversible."
    },
    {
      "title": "kuma.io/mesh annotation becomes a label",
      "detail": "On 3.0 the mesh association moves from an annotation to a label on the Pod/namespace. Re-label workloads before upgrading.",
      "command": "kubectl get ns,pods -A -o json | jq -r '.items[]|select(.metadata.annotations[\"kuma.io/mesh\"])|.metadata.name'"
    },
    {
      "title": "Split Pod-level vs container-level sidecar resources",
      "detail": "Sidecar resource requests move from Pod annotations to the container spec. Review overrides before upgrading."
    }
