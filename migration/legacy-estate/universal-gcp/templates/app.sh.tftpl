#!/usr/bin/env bash
set -euo pipefail
${bootstrap}

cat > /etc/kuma/dataplane.yaml <<'DATAPLANE'
${dataplane_yaml}
DATAPLANE
chmod 0444 /etc/kuma/dataplane.yaml

# The application and its sidecar share the VM's network namespace, which is what
# lets Envoy's inbound listener forward to 127.0.0.1:<servicePort> and the app dial
# its outbounds on 127.0.0.1.
docker rm -f app kuma-dp >/dev/null 2>&1 || true
docker run -d --name app --restart always --network host \
  ${app_env_flags} \
  ${app_image}

# No transparent proxying anywhere in this zone: with it enabled the Dataplane's
# own outbound[] list is discarded in favour of mesh VIPs, and the explicit
# outbounds this estate is built around stop existing.
#
# The dataplane token goes in as KUMA_DATAPLANE_RUNTIME_TOKEN, read from instance
# metadata — the env form of --dataplane-token-file, so nothing has to be written
# to disk. --skip-verify: the zone CP's dp-server serves an autogenerated
# self-signed certificate and kuma-dp has no CA for it.
docker run -d --name kuma-dp --restart always --network host \
  -e KUMA_DATAPLANE_RUNTIME_TOKEN="$(metadata dataplane-token)" \
  -v /etc/kuma:/etc/kuma:ro \
  ${dp_image} run \
  --cp-address=${cp_address} \
  --skip-verify \
  --dataplane-file=/etc/kuma/dataplane.yaml
